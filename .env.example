# ==============================================================================
# ENVIRONMENT VARIABLES UNTUK STATIC REACT SPA (VITE + SUPABASE)
# ==============================================================================
#
# PENTING UNTUK DEPLOYMENT GITHUB PAGES:
# Variabel yang diawali 'VITE_' akan di-embed langsung ke dalam kode JavaScript statis
# pada saat proses build (npm run build).
#
# Untuk deployment via GitHub Actions:
# 1. Buka Repositori GitHub Anda > Masuk ke menu Settings.
# 2. Pada menu kiri, pilih Secrets and variables > Actions.
# 3. Klik tombol "New repository secret" dan tambahkan dua variabel rahasia ini:
#
#    Nama Secret 1 : VITE_SUPABASE_URL
#    Nilai Secret  : https://xxxxxxxxxxxx.supabase.co
#
#    Nama Secret 2 : VITE_SUPABASE_ANON_KEY
#    Nilai Secret  : eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9... (kunci anon/publishable)
#
# ------------------------------------------------------------------------------
# 1. SUPABASE PROJECT URL
# Dapatkan dari: Supabase Dashboard > Project Settings > API > Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. SUPABASE ANON / PUBLISHABLE KEY
# Kunci ini aman untuk publik browser karena data dan bucket dilindungi oleh Row Level Security (RLS).
# JANGAN gunakan 'service_role' / secret key di sini!
# Dapatkan dari: Supabase Dashboard > Project Settings > API > Project API Keys > "anon" / "public"
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key-here

# ------------------------------------------------------------------------------
# 3. OPSIONAL: BASE PATH GITHUB PAGES
# Jika nama repositori Anda misalnya 'resto-maeso-aji', base path di vite.config.ts dapat diset:
# VITE_BASE_PATH=/resto-maeso-aji/
# (Secara default './' sudah dikonfigurasi sehingga otomatis berjalan tanpa diubah).
VITE_BASE_PATH=./
